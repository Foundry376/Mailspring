{
  "application:new-message": ["c", "mod+n"],

  "navigation:go-to-inbox": "i",
  "multiselect-list:select-all": ["mod+a", "shift+x"],

  "core:pop-sheet": ["escape", "u"],
  "core:previous-item": ["up", "k"],
  "core:select-up": ["shift+up", "shift+k"],
  "core:next-item": ["down", "j"],
  "core:select-down": ["shift+down", "shift+j"],
  "core:focus-item": ["enter", "o"],

  "message-list:previous-message": "p",
  "message-list:next-message": "n",

  "core:find-in-thread": "mod+f",
  "core:find-in-thread-next": "mod+g",
  "core:find-in-thread-previous": "mod+shift+g",

  "core:mute-conversation": "m",
  "core:focus-search": "/",
  "core:change-category": ".",
  "core:select-item": "x",
  "core:gmail-remove-from-view": "y",
  "core:archive-item": "e",
  "core:report-as-spam": "!",
  "core:delete-item": "#",
  "core:snooze-item": ["z", "h"],

  "core:reply": ["r", "mod+r", "mod+alt+r"],
  "core:reply-new-window": "shift+r",
  "core:reply-all": ["a", "mod+shift+r", "mod+alt+shift+r"],
  "core:reply-all-new-window": "shift+a",
  "core:forward": ["f", "mod+shift+f", "mod+alt+shift+f"],
  "core:forward-new-window": "shift+f",

  "core:remove-and-previous": ["}", "]"],
  "core:remove-and-next": ["{", "["],
  "core:undo": "mod+z"
}
