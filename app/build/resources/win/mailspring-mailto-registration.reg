Windows Registry Editor Version 5.00

[{{HKEY_ROOT}}\SOFTWARE\Classes\{{PRODUCT_NAME}}.Url.mailto]
"FriendlyTypeName"="{{PRODUCT_NAME}} Url"

[{{HKEY_ROOT}}\SOFTWARE\Classes\{{PRODUCT_NAME}}.Url.mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Classes\{{PRODUCT_NAME}}.Url.mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Classes\{{PRODUCT_NAME}}.Url.mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart {{EXE_NAME}} --process-start-args %1"


[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}]
@="{{PRODUCT_NAME}}"
"LocalizedString"="@{{PATH_TO_ROOT_FOLDER}}\\Update.exe,-123"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\{{EXE_NAME}},1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Capabilities]
"ApplicationName"="{{PRODUCT_NAME}}"
"ApplicationDescription"="A fast, modern mail client designed to help you boost your productivity."

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Capabilities\StartMenu]
"Mail"="{{PRODUCT_NAME}}"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Capabilities\URLAssociations]
"mailto"="{{PRODUCT_NAME}}.Url.mailto"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols\mailto]
@="URL:MailTo Protocol"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols\mailto\DefaultIcon]
@="{{PATH_TO_APP_FOLDER}}\\{{EXE_NAME}},1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols\mailto\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols\mailto\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\Protocols\mailto\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart {{EXE_NAME}} --process-start-args %1"

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\shell]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\shell\open]

[{{HKEY_ROOT}}\SOFTWARE\Clients\Mail\{{PRODUCT_NAME}}\shell\open\command]
@="\"{{PATH_TO_ROOT_FOLDER}}\\Update.exe\" --processStart {{EXE_NAME}}"

[{{HKEY_ROOT}}\SOFTWARE\RegisteredApplications]
"{{PRODUCT_NAME}}"="Software\\Clients\\Mail\\{{PRODUCT_NAME}}\\Capabilities"


[HKEY_CURRENT_USER\SOFTWARE\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache]
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe"="{{PRODUCT_NAME}}"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.FriendlyAppName"="{{PRODUCT_NAME}}"
"{{PATH_TO_ROOT_FOLDER}}\\Update.exe.ApplicationCompany"="{{PRODUCT_NAME}}"
