#!/bin/bash
# mkdeb version arch control-file-path desktop-file-path icon-file-path sources-file-path deb-file-path

set -e

SCRIPT=`readlink -f "$0"`
ROOT=`readlink -f $(dirname $SCRIPT)/..`
cd $ROOT

VERSION="$1"
ARCH="$2"
ICON_FILE="$3"
LINUX_ASSETS_DIRECTORY="$4"
APP_CONTENTS_DIRECTORY="$5"
OUTPUT_PATH="$6"
NAME="$7"
DESKTOP_NAME="$8"

FILE_MODE=755

TARGET_ROOT="`mktemp -d`"
chmod $FILE_MODE "$TARGET_ROOT"
TARGET="$TARGET_ROOT/$NAME-$VERSION-$ARCH"

mkdir -m $FILE_MODE -p "$TARGET/usr"
mkdir -m $FILE_MODE -p "$TARGET/usr/share"
cp -r "$APP_CONTENTS_DIRECTORY" "$TARGET/usr/share/$NAME"
chmod +rx "$TARGET/usr/share/$NAME"

mkdir -m $FILE_MODE -p "$TARGET/DEBIAN"
cp "$OUTPUT_PATH/control" "$TARGET/DEBIAN/control"

sed "s|/usr/share/mailspring/|/usr/share/$NAME/|g" "$LINUX_ASSETS_DIRECTORY/debian/postinst" > "$TARGET/DEBIAN/postinst"
chmod 755 "$TARGET/DEBIAN/postinst"

mkdir -m $FILE_MODE -p "$TARGET/usr/bin"
ln -s "../share/$NAME/$NAME" "$TARGET/usr/bin/$NAME"
chmod +x "$TARGET/usr/bin/$NAME"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/applications"
cp "$OUTPUT_PATH/$DESKTOP_NAME" "$TARGET/usr/share/applications"
mkdir -m $FILE_MODE -p "$TARGET/usr/share/metainfo"
cp "$OUTPUT_PATH/$NAME.metainfo.xml" "$TARGET/usr/share/metainfo"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/pixmaps"
cp "$ICON_FILE" "$TARGET/usr/share/pixmaps/$NAME.png"

mkdir -m $FILE_MODE -p "$TARGET/usr/share/icons/hicolor"
for i in 256 128 64 32 16; do
  mkdir -p "$TARGET/usr/share/icons/hicolor/${i}x${i}/apps"
  cp "$LINUX_ASSETS_DIRECTORY/icons/${i}.png" "$TARGET/usr/share/icons/hicolor/${i}x${i}/apps/$NAME.png"
done

# Copy the generated license to the package documentation directory.
mkdir -m $FILE_MODE -p "$TARGET/usr/share/doc/$NAME"
cp "$TARGET/usr/share/$NAME/LICENSE" "$TARGET/usr/share/doc/$NAME/copyright"

# Add lintian overrides
mkdir -m $FILE_MODE -p "$TARGET/usr/share/lintian/overrides"
sed "s/^mailspring:/$NAME:/" "$ROOT/build/resources/linux/debian/lintian-overrides" > "$TARGET/usr/share/lintian/overrides/$NAME"

# Remove group write from all files
chmod -R g-w "$TARGET";

# Remove execstack bit from mailspring executable (execstack is x86-only, skip on other archs)
if command -v execstack &> /dev/null; then
  execstack --clear-execstack "$TARGET/usr/share/$NAME/$NAME"
fi

# Remove executable bit from .node files
find "$TARGET" -type f -name "*.node" -exec chmod a-x {} \;

fakeroot dpkg-deb -b "$TARGET"
mv "$TARGET_ROOT/$NAME-$VERSION-$ARCH.deb" "$OUTPUT_PATH"
rm -rf "$TARGET_ROOT"
